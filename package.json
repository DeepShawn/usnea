{
  "name": "usnea-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --if-present typecheck",
    "test": "vitest run --passWithNoTests",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@changesets/cli": "^3.0.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
