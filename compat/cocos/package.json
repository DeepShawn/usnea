{
  "name": "@usnea/compat-cocos",
  "version": "0.0.0",
  "private": true,
  "description": "Compatibility layer offering Cocos-style APIs on top of Usnea (independent implementation).",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeepShawn/usnea.git",
    "directory": "compat/cocos"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
