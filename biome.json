{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/coverage",
      "!**/.tmp",
      "!docs/PLAN.md",
      "!pnpm-lock.yaml",
      "!**/*.md"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "assist": { "enabled": true }
}
