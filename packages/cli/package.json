{
  "name": "@usnea/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Command line interface for Usnea projects.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeepShawn/usnea.git",
    "directory": "packages/cli"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "usnea-src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json"
  },
  "bin": {
    "usnea": "./dist/cli.js"
  },
  "dependencies": {
    "usnea": "workspace:*",
    "@usnea/headless": "workspace:*",
    "@usnea/platform-web": "workspace:*",
    "@usnea/render-webgl2": "workspace:*",
    "vite": "^8"
  },
  "peerDependencies": {
    "playwright": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22",
    "playwright": "1.63.0"
  }
}
