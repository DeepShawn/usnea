{
  "name": "create-usnea",
  "version": "0.0.0",
  "description": "Project scaffolding for Usnea (npm create usnea).",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeepShawn/usnea.git",
    "directory": "packages/create-usnea"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "create-usnea": "./dist/index.js"
  },
  "exports": {
    ".": {
      "usnea-src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "template"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@usnea/cli": "workspace:*",
    "usnea": "workspace:*"
  }
}
