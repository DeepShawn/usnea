{
  "name": "@usnea/headless",
  "version": "0.0.0",
  "private": true,
  "description": "Headless backend for Node.js, for tests, CI and AI self-verification.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeepShawn/usnea.git",
